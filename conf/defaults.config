#!/usr/bin/env nextflow

/*
 * -------------------------------------------------
 *  amchakra/tosca config file
 * -------------------------------------------------
 * Default parameters config
 */

params {

    org = false
    genomesdir = false
    genome_fai = false
    transcript_fa = false
    transcript_fai = false
    transcript_gtf = false
    star_genome = false
    regions_gtf = false

    // Cutadapt
    adapter = 'AGATCGGAAGAGC'
    min_quality = 10
    min_readlength = 16

    // Premapping
    skip_premap = false

    // Additional STAR args
    star_args = ''

    // Linear-read filter: remove reads STAR aligns linearly over (nearly) their whole length
    skip_linear_filter = false
    linear_reference = 'auto'      // auto: genome premap if run, else transcript; or 'genome' / 'transcript'
    linear_min_frac = 0.9          // minimum fraction of the read aligned (M/I/=/X)
    linear_max_del = 8             // maximum single deletion (nt); longer gaps are left for BLAT
    linear_star_index = false      // prebuilt STAR index of transcript_fa (built if not given)
    linear_star_args = ''          // extra STAR args for the transcript alignment

    // Repeat-shift flag on deduplicated hybrids
    drop_repeat_shifts = false

    // BLAT options
    step_size = 5
    tile_size = 11
    min_score = 15

    // Hybrid identification
    split_size = 100000
    evalue = 0.001
    maxhits = 100
    xlink_distance = false         // crosslink-distance filter: keep a hybrid only if one arm starts before this
                                   // read position. ~5 for hiCLIP/iCLIP-style reads (read 5' end = crosslink);
                                   // false = off (SPLASH, PARIS, COMRADES)

    // Hybrid processing
    umi_separator = '_'
    dedup_method = 'directional'
    chunk_number = 100
    cluster_old = false
    slurm = false
    analyse_structures = false
    clusters_only = true
    shuffled_energies = false
    intertranscript_only = false
    omit_highincidence = 10000
    omit_transcripts = ''
    percent_overlap = 0.75
    sample_size = -1
    cluster_method = 'components'
    weight_cluster = 'FALSE'

    // Atlas
    skip_atlas = false
    atlas = false

    // Contact maps and arcs
    goi = false
    bin_size = 100
    breaks = "none"
    skip_arcs = false

    //QC
    skip_qc = false

}

